# EmDash CMS Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials

# Cloudflare Bindings (configured in wrangler.toml for local dev)
# DB binding name: DB
# MEDIA binding name: MEDIA

# EmDash Admin Authentication
# Generate with: npx emdash auth secret
# EMDASH_AUTH_SECRET=

# Cloudflare Access (if behind Cloudflare Access)
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# External API Keys (if needed)
# Do not hardcode API keys - use environment variables
# GOOGLE_MAPS_API_KEY=
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=

# Development
NODE_ENV=development
