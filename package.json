{
	"name": "nexus-emdash",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"build:staging": "CLOUDFLARE_ENV=staging astro build",
		"preview": "astro preview",
		"deploy": "astro build && wrangler deploy",
		"deploy:staging": "CLOUDFLARE_ENV=staging astro build && wrangler deploy --env staging",
		"typecheck": "astro check",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.3.4",
		"@astrojs/react": "6.0.6",
		"@emdash-cms/cloudflare": "1.2.0",
		"@emdash-cms/plugin-forms": "0.2.9",
		"@emdash-cms/plugin-webhook-notifier": "0.2.3",
		"astro": "7.3.6",
		"emdash": "1.2.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@cloudflare/workers-types": "5.20261007.1",
		"typescript": "5.9.3",
		"wrangler": "4.148.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"overrides": {
		"miniflare": {
			"sharp": "0.35.5"
		},
		"@codemirror/language": "6.12.4"
	}
}
