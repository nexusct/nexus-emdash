{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nexus-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nexus-emdash-db","database_id": "2bc4951e-66c9-4d48-b4fa-ee7681750451",
			// Run `wrangler d1 create my-emdash-site` and paste the ID here
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "nexus-emdash-media","preview_bucket_name": "nexus-emdash-media",
		},
	],
	"observability": {
		"enabled": true,
	},
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"env": {
		"staging": {
			"name": "nexus-emdash-staging",
			// Keep the first deployment private until Cloudflare Access is configured.
			"workers_dev": false,
			"preview_urls": false,
			"routes": [],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "nexus-emdash-staging-db",
					// Add only the isolated staging database ID after provisioning.
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "nexus-emdash-staging-media",
					"preview_bucket_name": "nexus-emdash-staging-media",
				},
			],
			"kv_namespaces": [{ "binding": "SESSION" }],
			"worker_loaders": [{ "binding": "LOADER" }],
		},
	},
}
